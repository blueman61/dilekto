# Bu dosya yalnızca ayar ADLARINI gösterir. Gerçek değerler Vercel >
# Settings > Environment Variables ekranına girilir; asla depoya yazılmaz.
# Yerelde denemek için bu dosyayı .env.local adıyla kopyalayabilirsiniz.

# Yapay zekâ: gemini | claude | ornek (ornek = yapay zekâsız örnek metin, yalnızca geliştirme)
YAPAY_ZEKA=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Supabase (Project Settings > Data API ve API Keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gece çalışan silme görevini korur (rastgele, en az 32 karakter)
CRON_SECRET=

# Ödeme: deneme (para çekilmez). Gerçek sağlayıcı eklenince değişecek.
ODEME_MODU=deneme

# Robot koruması (Cloudflare Turnstile, isteğe bağlı)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Günlük en fazla kaç taslak üretilebilir (maliyet koruması)
GUNLUK_TASLAK_SINIRI=100

# Alan adı bağlanınca:
# SITE_ADRESI=https://dilekto.com
# Site Google'a açılacağı zaman:
# SITE_ARAMA_MOTORLARINA_ACIK=evet
